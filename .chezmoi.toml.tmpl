# Modules that replace each other: selecting both of a pair stops init.
# Tools every install gets, shown above the checklist.
# [[ $required := "fish, git, gh, starship, mergiraf, uv and fnm" ]] #
# Modules the install checklist starts with already selected.
# [[ $defaults := list "editor" "shell_tools" "cli_extras" "rust" "git_advanced" "atuin" "python_dev" "gcloud" ]] #
# [[ $pairs := list (list "ghostty" "cmux") (list "pre_commit" "prek") (list "terraform" "opentofu") ]] #
# The bare `chezmoi init` prompt starts with the same modules checked; the default must be the full choice text.
# [[ $preselected := list ]] #
# [[ range $choices ]] #
# [[ if has (index (splitList " | " .) 0) $defaults ]] #
# [[ $preselected = append $preselected . ]] #
# [[ end ]] #
# [[ end ]] #
# The saved module list carries the version of the module set it was made for
# (.chezmoitemplates/modulesVersion). A list saved for an older set is migrated by
# .chezmoitemplates/modules, the same template that apply and update consult.
# [[ $modulesVersion := includeTemplate "modulesVersion" . | int ]] #
# [[ $legacy := and (hasKey . "modules") (lt (int (default 0 (get . "modulesVersion"))) $modulesVersion) ]] #
# [[ $stored := promptMultichoiceOnce . "modules" "Select optional modules" $choices $preselected ]] #
# [[ $modules := list ]] #
# [[ range $stored ]] #
# [[ $name := index (splitList " | " .) 0 ]] #
# [[ $modules = append $modules (ternary "ghostty" $name (eq $name "terminal")) ]] #
# [[ end ]] #
# [[ if $legacy ]] #
# [[ $modules = includeTemplate "modules" (dict "modules" $modules) | fromJson ]] #
# [[ end ]] #
# [[ $modules = without ($modules | uniq) "multiplexer" ]] #
# [[ range $pairs ]] #
# [[ if and (has (index . 0) $modules) (has (index . 1) $modules) ]] #
# [[ fail (printf "%s and %s are alternatives: choose one" (index . 0) (index . 1)) ]] #
# [[ end ]] #
# [[ end ]] #
modulesVersion = # [[ $modulesVersion ]] #
modules = # [[ $modules | toJson ]] #

# A release install leaves the clone on a detached tag, where chezmoi's default
# `git pull --rebase` fails. The command runs in the clone and uses its own
# origin, so a fork keeps updating from the fork: on a branch (a fork, or a
# branch chosen with ARTEFILES_VERSION) it pulls as chezmoi does, on a tag it
# moves to the newest release tag of that origin.
[update]
  command = "sh"
  args = ["-c", '''
    if git symbolic-ref -q HEAD > /dev/null; then
      exec git pull --autostash --rebase
    fi
    current=$(git describe --tags --exact-match --match "v[0-9]*" 2> /dev/null) || {
      echo 'The source is not on a branch or a release tag; put it on one with: git -C "$(chezmoi source-path)" switch <branch>' >&2
      exit 1
    }
    git fetch --quiet --force --tags origin || exit 1
    latest=$(git tag --list "v[0-9]*" | sort -V | tail -n 1)
    if [ "$latest" = "$current" ]; then
      echo "already at $current"
      exit 0
    fi
    git checkout --quiet --detach "$latest" || {
      echo "Could not check out $latest; commit or stash the changes in the source." >&2
      exit 1
    }
    echo "moved from $current to $latest"
  ''']

# [[ if has "git_advanced" $modules ]] #
[merge]
  command = "mergiraf"
  args = ["merge", "--output", "{{ .Source }}", "{{ .Target }}", "{{ .Source }}", "{{ .Destination }}"]

[diff]
  command = "difft"
  args = ["--display=inline", "{{ .Destination }}", "{{ .Target }}"]
# [[ end ]] #
