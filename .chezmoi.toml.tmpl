# chezmoi:template:left-delimiter="# [[" right-delimiter="]] #"
sourceDir = # [[ .chezmoi.sourceDir | quote ]] #

[data]
# The profile calls return an empty string when gh is missing, logged out or
# refused (a CI job token cannot call `gh api user`), so init never stops on them.
# The name falls back to the one already stored in the config, so a failing gh on
# a re-init never rewrites an existing git author name, and only then to the
# system user; the email follows the chain below.
# [[ $ghLogin := output "sh" "-c" "gh api user --jq .login 2>/dev/null || true" | trim ]] #
name = # [[ default (default .chezmoi.username (get . "name")) $ghLogin | quote ]] #
# The default email is the public GitHub one, else firstname.lastname@<company>
# built from a profile name of exactly two plain words; any other name gets no
# guess rather than a wrong address.
# [[ $companyDomain := "artefact.com" ]] #
# [[ $ghEmail := output "sh" "-c" "gh api user --jq '.email // empty' 2>/dev/null || true" | trim ]] #
# [[ $ghName := output "sh" "-c" "gh api user --jq '.name // empty' 2>/dev/null || true" | trim ]] #
# [[ $defaultEmail := $ghEmail ]] #
# [[ if and (not $defaultEmail) (regexMatch "^[A-Za-z-]+ [A-Za-z-]+$" $ghName) ]] #
# [[ $defaultEmail = printf "%s@%s" ($ghName | lower | replace " " ".") $companyDomain ]] #
# [[ end ]] #
email = # [[ promptStringOnce . "email" (printf "Email (default: %s, press enter to accept)" $defaultEmail) $defaultEmail | quote ]] #
# Set the desired credential helper.
# Examples: "!gh auth git-credential", "osxkeychain", "cache --timeout=3600"
credentialHelper = "!gh auth git-credential"
