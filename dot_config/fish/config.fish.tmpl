# chezmoi:template:left-delimiter="# [[" right-delimiter="]] #"

# [[ if eq .chezmoi.os "darwin" -]] #
# Fish shell configuration for macOS development environment
# [[ else -]] #
# Fish shell configuration for Linux development environment
# [[ end -]] #

###########################################
# PATH CONFIGURATION - ORDER MATTERS
###########################################

# [[ if eq .chezmoi.os "darwin" -]] #
# Ensure Homebrew is in PATH before anything else
# Handle both Apple Silicon (/opt/homebrew) and Intel (/usr/local) Mac architectures
if test -d "/opt/homebrew/bin"
    fish_add_path --prepend "/opt/homebrew/bin"
    fish_add_path --prepend "/opt/homebrew/sbin"
else if test -d "/usr/local/bin"
    fish_add_path --prepend "/usr/local/bin"
    fish_add_path --prepend "/usr/local/sbin"
end

# Set all Homebrew environment variables (PATH, MANPATH, INFOPATH)
if type -q brew
    if not set -q HOMEBREW_PREFIX
        eval "$(brew shellenv)"
    end
end
# [[ end ]] #

# User-specific executables
if test -d $HOME/.local/bin
    fish_add_path $HOME/.local/bin
end

# Add language-specific and tool paths
if test -d $HOME/.fzf/bin
    fish_add_path $HOME/.fzf/bin
end

if test -d $HOME/.cargo/bin
    fish_add_path $HOME/.cargo/bin
end

# [[ if has "gcloud" .modules -]] #
# Google Cloud SDK configuration
# [[ if eq .chezmoi.os "darwin" -]] #
if type -q brew; and set -q HOMEBREW_PREFIX
    set gcloud_cask_root ""

    if test -d "$HOMEBREW_PREFIX/Caskroom/gcloud-cli"
        set gcloud_cask_root "$HOMEBREW_PREFIX/Caskroom/gcloud-cli/latest/google-cloud-sdk"
    else if test -d "$HOMEBREW_PREFIX/Caskroom/google-cloud-sdk"
        set gcloud_cask_root "$HOMEBREW_PREFIX/Caskroom/google-cloud-sdk/latest/google-cloud-sdk"
    end

    if test -n "$gcloud_cask_root"
        fish_add_path "$gcloud_cask_root/bin"

        function __init_gcloud --on-event fish_preexec
            if string match -q "gcloud*" (commandline)
                if test -f "$gcloud_cask_root/path.fish.inc"
                    source "$gcloud_cask_root/path.fish.inc"
                end
                functions --erase __init_gcloud
            end
        end
    end
end
# [[ else -]] #
# Linux-specific Google Cloud SDK path
if test -d $HOME/.local/google-cloud-sdk
    fish_add_path $HOME/.local/google-cloud-sdk/bin
    set -gx CLOUDSDK_PYTHON /usr/bin/python3

    if test -f $HOME/.local/google-cloud-sdk/path.fish.inc
        source $HOME/.local/google-cloud-sdk/path.fish.inc
    end
end
# [[ end -]] #
# [[ end -]] #

# [[ if has "atuin" .modules -]] #
# Atuin shell history tool
if test -d $HOME/.atuin/bin
    fish_add_path $HOME/.atuin/bin
end
# [[ end -]] #

# nvm Node Version Manager
# [[ if eq .chezmoi.os "linux" -]] #
if test -d "$HOME/.nvm"
    set -gx NVM_DIR (test -z "$XDG_CONFIG_HOME"; and printf %s "$HOME/.nvm"; or printf %s "$XDG_CONFIG_HOME/nvm")
    # nvm.sh is a bash script; fish's own `source` parses it as fish
    # syntax and fails, so route it through bass instead.
    test -s "$NVM_DIR/nvm.sh"; and bass source "$NVM_DIR/nvm.sh"
end
# [[ end ]] #

###########################################
# ENVIRONMENT VARIABLES
###########################################

# Text editors
# [[ if has "editor" .modules -]] #
set -gx EDITOR nvim
set -gx VISUAL nvim
# [[ else -]] #
set -gx EDITOR vi
set -gx VISUAL vi
# [[ end -]] #

# Terminal capabilities
set -gx TERM xterm-256color

# [[ if has "git_advanced" .modules -]] #
# Use difftastic for git diffs if available
if type -q difft
    set -gx GIT_EXTERNAL_DIFF difft
end
# [[ end -]] #

###########################################
# TOOL CONFIGURATION
###########################################

# FZF fuzzy finder - global QoL, applies to every invocation (ctrl-t, alt-c,
# fuzzy_complete, and any script/plugin that shells out to fzf).
set -gx FZF_DEFAULT_OPTS "\
--height=~40% --layout=reverse --border=none --cycle --highlight-line \
--scroll-off=3 --info=inline-right --pointer='▶' --marker='✓ ' \
--bind=ctrl-/:toggle-preview \
--bind=ctrl-a:select-all,ctrl-d:deselect-all"

# Starship prompt - https://starship.rs
if type -q starship
    function __init_starship --on-event fish_prompt
        starship init fish | source
        functions --erase __init_starship
    end
end

# Zoxide smarter cd - https://github.com/ajeetdsouza/zoxide
if type -q zoxide
    function __init_zoxide --on-event fish_prompt
        zoxide init fish --cmd cd | source
        # zoxide's own init registers `complete -c cd --wraps __zoxide_z`,
        # which makes fish treat cd as already having completions and skip
        # autoloading completions/cd.fish for the rest of THIS interactive
        # session - so the ranked-jump completion must also be registered
        # here explicitly. completions/cd.fish still autoloads normally in
        # the fresh non-interactive `fish -c` subshells fuzzy_complete's
        # change:reload spawns, since those never source zoxide init.
        source $__fish_config_dir/completions/cd.fish
        functions --erase __init_zoxide
    end
end

# Direnv is initialised in conf.d/direnv.fish, which shadows homebrew's
# eager vendor hook - https://direnv.net

# Chezmoi dotfile manager - https://chezmoi.io
if type -q chezmoi
    function __init_chezmoi_completions --on-event fish_preexec
        if string match -q "chezmoi*" (commandline)
            chezmoi completion fish | source
            functions --erase __init_chezmoi_completions
        end
    end
end

# FZF configuration with custom key bindings
if type -q fzf
    set -x FZF_DISABLE_KEYBINDINGS 1
    __cached_init fzf fzf --fish
    # Drop FZF's own alt-c cd widget; Alt+Shift+C below is the directory jump.
    bind -e alt-c 2>/dev/null
    if bind -M insert >/dev/null 2>&1
        bind -M insert -e alt-c 2>/dev/null
    end
    bind \ct __fzf_search_current_dir      # Ctrl+T: search files
    bind \eC '__fzf_cd --hidden'           # Alt+Shift+C: cd with hidden files

    # Route the completion picker itself (Tab) through fzf.
    bind \t fuzzy_complete
    if bind -M insert >/dev/null 2>&1
        bind -M insert \t fuzzy_complete
    end
end

# [[ if has "atuin" .modules -]] #
# Atuin shell history with search - https://atuin.sh
if type -q atuin
    # atuin's init spawns `atuin uuid` for the session id; uuidgen produces the
    # same 32 hex chars for a fraction of the cost, so seed the two variables
    # the init checks before sourcing it.
    if type -q uuidgen
        if not set -q ATUIN_SESSION; or test "$ATUIN_SHLVL" != "$SHLVL"
            set -gx ATUIN_SESSION (uuidgen | string lower | string replace -a - '')
            set -gx ATUIN_SHLVL $SHLVL
        end
    end

    set -gx ATUIN_NOBIND true
    # --disable-up-arrow: keep fish's native up/down prefix search on the arrow
    # keys, instead of Atuin's own history TUI.
    __cached_init atuin atuin init fish --disable-up-arrow
    __cached_init atuin-completions atuin gen-completions --shell fish
end

# Atuin history rendered through fzf instead of atuin's own TUI, when both
# tools are present.
if status is-interactive; and type -q fzf; and type -q atuin
    bind ctrl-r '__atuin_fzf_search directory'
    bind alt-r '__atuin_fzf_search directory'
    bind alt-f '__atuin_fzf_search global'
    if bind -M insert >/dev/null 2>&1
        bind -M insert ctrl-r '__atuin_fzf_search directory'
        bind -M insert alt-r '__atuin_fzf_search directory'
        bind -M insert alt-f '__atuin_fzf_search global'
    end
end
# [[ end -]] #

# Docker - https://www.docker.com
if type -q docker
    function __init_docker_completions --on-event fish_preexec
        if string match -q "docker*" (commandline)
            docker completion fish | source
            functions --erase __init_docker_completions
        end
    end
end

# Rip (alternative rm) completions
# Lazy load completions on first use. `rm` is aliased to `rip` (see
# aliases.fish), so the trigger has to match what's actually typed, not just
# the literal "rip" - otherwise this hook never fires for real usage.
if type -q rip
    function __init_rip_completions --on-event fish_preexec
        if string match -qr '^(rip|rm)' (commandline)
            rip completions fish | source
            functions --erase __init_rip_completions
        end
    end
end


###########################################
# ALIASES AND USER PREFERENCES
###########################################

# Disable fish greeting message
set fish_greeting

# Theme management - Only apply in interactive sessions
if status is-interactive
    # Check for theme persistence file
    set -l theme_file "$HOME/.config/fish/theme_preference"

    # Function to detect if theme appears to be intentionally set by the user
    # This checks common user configuration files for theme settings
    function __is_theme_user_defined
        # Check if any fish theme variables are set in fish_variables
        if test -f "$HOME/.config/fish/fish_variables"
            and grep -q "^SETUVAR fish_color_" "$HOME/.config/fish/fish_variables"
            return 0
        end

        # Check if a theme file exists and has content
        if test -f $theme_file
            and test -s $theme_file
            return 0
        end

        # Check for theme setting in universal variables
        if set -q fish_colors
            return 0
        end

        return 1
    end

    # Get current theme if possible
    set -l current_theme ""
    if type -q fish_config
        # Try to get current theme - might not work in all fish versions
        set current_theme (fish_config theme current 2>/dev/null)
    end

    # Default theme - Catppuccin Mocha
    set -l default_theme ""

    # Apply theme logic
    if __is_theme_user_defined
        # User has a theme set - save it if not already saved
        if test -n "$current_theme"
            and not test -f $theme_file
            echo $current_theme > $theme_file 2>/dev/null
        end
    else
        # No user-defined theme found - use Catppuccin Mocha as default
        if type -q fish_config
            set -l available_themes (fish_config theme list 2>/dev/null)

            # First priority: Find Catppuccin Mocha specifically
            for theme in $available_themes
                if string match -q "*[Cc]atppuccin*[Mm]ocha*" $theme
                    set default_theme $theme
                    break
                end
            end

            # Second priority: Any Catppuccin variant if Mocha isn't available
            if test -z "$default_theme"
                for theme in $available_themes
                    if string match -q "*[Cc]atppuccin*" $theme
                        set default_theme $theme
                        break
                    end
                end
            end

            # Apply the default theme if found and different from current
            if test -n "$default_theme" -a "$current_theme" != "$default_theme"
                fish_config theme choose $default_theme 2>/dev/null
                # Only show message when theme changes
                echo "Theme changed to $default_theme"
                echo $default_theme > $theme_file 2>/dev/null
            end
        end
    end

    # Clean up our temporary function
    functions -e __is_theme_user_defined
end

# Load separate aliases file
if test -f $HOME/.config/fish/aliases.fish
    source $HOME/.config/fish/aliases.fish
end

# Load local machine-specific config (not managed by chezmoi)
if test -f $HOME/.config/fish/local.config.fish
    source $HOME/.config/fish/local.config.fish
end
