#!/usr/bin/env bats
# Release notes live on the GitHub releases page, generated by git-cliff when a release
# is cut. CHANGELOG.md only points there, so nothing may expect it to be regenerated.

setup() {
  load 'helpers/setup'
}

@test "CHANGELOG.md points at the releases page and holds no release of its own" {
  grep -qF 'https://github.com/artefactory/artefiles/releases' "$REPO_ROOT/CHANGELOG.md"
  if grep -nE '^## ' "$REPO_ROOT/CHANGELOG.md"; then echo "a release section is back in CHANGELOG.md" >&2; return 1; fi
}

@test "no pre-commit or pre-push hook depends on CHANGELOG.md" {
  # A hook that regenerates the file and compares it can never fire now that cliff.toml
  # prints instead of writing, so it would pass while checking nothing.
  if grep -n 'CHANGELOG' "$REPO_ROOT/.pre-commit-config.yaml"; then return 1; fi
}

@test "the README sends readers to the releases page for the history" {
  grep -qF '](https://github.com/artefactory/artefiles/releases)' "$REPO_ROOT/README.md"
  if grep -nF '](CHANGELOG.md)' "$REPO_ROOT/README.md"; then return 1; fi
}

@test "the changelog file is not managed by chezmoi" {
  H=$(mk_fake_home)
  seed_chezmoi_config "$H" '{"modules":[]}'
  if chezmoi_managed "$H" | grep -Fx 'CHANGELOG.md'; then return 1; fi
}
