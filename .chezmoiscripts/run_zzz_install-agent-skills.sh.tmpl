#!/bin/sh
# chezmoi:template:left-delimiter="# [[" right-delimiter="]] #"
# Keep agent skills installed and up to date via `gh skill`, reading the
# actual skill list from the org's shared skills repo (never hardcoded
# here — see .chezmoidata/agent_skills.yaml). No run_onchange gating:
# this must reconcile against upstream on every apply, not only when
# something in this repo changes.
#
# Never --force: a name collision with a skill the user authored or
# installed themselves must be left alone, not silently overwritten.
# `gh skill update --all` is what brings already-tracked skills up to
# date; a plain `install` only adds what's missing.

set -eu

# A name collision (already-installed skill) makes `gh skill` prompt to
# overwrite; this script runs from chezmoi apply, which is sometimes
# invoked with a real TTY attached, so left unset that prompt can block
# waiting for input instead of hitting the warning handling below.
export GH_PROMPT_DISABLED=1

ORG_SKILLS_REPO="# [[ .orgSkillsRepo ]] #"

if ! command -v gh > /dev/null 2>&1; then
  echo "gh not found — skipping agent skill sync" >&2
  exit 0
fi

if ! gh skill --help > /dev/null 2>&1; then
  echo "gh skill unavailable (gh CLI too old, needs >= 2.90) — skipping agent skill sync" >&2
  exit 0
fi

if ! gh auth status > /dev/null 2>&1; then
  echo "gh is not authenticated (run 'gh auth login') — skipping agent skill sync" >&2
  exit 0
fi

if ! gh skill update --all; then
  echo "warning: failed to update already-installed agent skills" >&2
fi

# 1. Custom skills authored directly in the org skills repo.
# [[ range .agentSkillTargets ]] #
if ! gh skill install "$ORG_SKILLS_REPO" --agent "# [[ . ]] #" --scope user --all; then
  echo "warning: could not install custom skills from $ORG_SKILLS_REPO for agent # [[ . ]] # (no read access? none defined yet?)" >&2
fi
# [[ end ]] #

# 2. Recommended external skills, listed as pointers in the org skills
# repo's recommended-skills.txt (never vendored — installed straight
# from their own source repos). `gh skill install` only takes one
# skill name per invocation, so "bulk" here means running the
# per-(repo, skill, agent) installs concurrently instead of one at a
# time — a manifest of any real size is dominated by network latency,
# not CPU, so this cuts wall-clock roughly by the concurrency factor.
manifest=$(gh api -H "Accept: application/vnd.github.raw" "repos/$ORG_SKILLS_REPO/contents/recommended-skills.txt" 2> /dev/null) || manifest=""
if [ -z "$manifest" ]; then
  echo "warning: could not fetch recommended-skills.txt from $ORG_SKILLS_REPO — skipping" >&2
else
  manifest_file=$(mktemp)
  trap 'rm -f "$manifest_file"' EXIT
  printf '%s\n' "$manifest" > "$manifest_file"

  max_parallel=8
  running=0
  # Read from a file, not a pipe: piping into `while` would run the
  # loop in a subshell, and the background jobs it starts would then
  # be that subshell's children — invisible to the `wait` calls below.
  while IFS=' ' read -r repo skill; do
    case "$repo" in
      ''|'#'*) continue ;;
    esac
    # [[ range .agentSkillTargets ]] #
    (
      if ! gh skill install "$repo" "$skill" --agent "# [[ . ]] #" --scope user; then
        echo "warning: could not install skill '$skill' from $repo for agent # [[ . ]] # (already exists under that name? see above)" >&2
      fi
    ) &
    running=$((running + 1))
    if [ "$running" -ge "$max_parallel" ]; then
      wait
      running=0
    fi
    # [[ end ]] #
  done < "$manifest_file"
  wait
fi

exit 0
