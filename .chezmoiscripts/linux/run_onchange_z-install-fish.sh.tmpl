#!/bin/sh
# Start fish from bash and zsh on Linux. fish itself is the static release
# build that .chezmoiexternal.toml.tmpl installs to ~/.local/bin/fish.
# https://fishshell.com/

set -eu

# We always target $HOME/.local/bin/fish so a system-installed fish
# (e.g. /usr/bin/fish from apt) cannot shadow or be confused with our
# user-local install.
LOCAL_FISH="$HOME/.local/bin/fish"

if command -v fish > /dev/null 2>&1 && [ "$(command -v fish)" != "$LOCAL_FISH" ]; then
  echo "Note: a system fish was found at $(command -v fish); bash and zsh start $LOCAL_FISH instead."
fi

# Create a wrapper script in ~/.local/bin to launch fish
WRAPPER_SCRIPT="${HOME}/.local/bin/start-fish"
mkdir -p "${HOME}/.local/bin"

cat > "${WRAPPER_SCRIPT}" << EOF
#!/bin/sh
exec "${LOCAL_FISH}" "\$@"
EOF
chmod +x "${WRAPPER_SCRIPT}"

# Add to shell config to auto-start fish for interactive shells
for RC_FILE in "${HOME}/.bashrc" "${HOME}/.zshrc"; do
  if [ -f "${RC_FILE}" ] && ! grep -q "start-fish" "${RC_FILE}"; then
    {
      echo ""
      echo "# Auto-start fish shell for interactive sessions"
      echo "if [ -t 1 ] && [ -x ${WRAPPER_SCRIPT} ]; then"
      echo "  exec ${WRAPPER_SCRIPT}"
      echo "fi"
    } >> "${RC_FILE}"
  fi
done

echo "Fish shell setup complete."
