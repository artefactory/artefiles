# [[ /* chezmoi:template:left-delimiter="# [[" right-delimiter="]] #" */ ]]
#!/bin/sh

# Removes Docker Desktop installations (forbidden by company policy).
# Recommends Colima as a replacement on macOS, native Docker Engine on Linux.
# [[ if ne .chezmoi.os "windows" ]] #

set -u

# What runs Docker Desktop (the app, its root helpers, the package) must go:
# while any of it is left the step fails, and chezmoi retries a failed
# run_once_ script, so rerunning install.sh finishes the job. Leftover data
# cannot run Docker Desktop, so data that cannot be removed never fails it.

# Highlight only on a terminal: through a pipe or into a log, escape codes
# would show as noise. The !!! banner stays visible either way.
if [ -t 1 ] && [ -z "${NO_COLOR:-}" ]; then
  BOLD=$(printf '\033[1m')
  YELLOW=$(printf '\033[1;33m')
  RED=$(printf '\033[1;31m')
  RESET=$(printf '\033[0m')
else
  BOLD="" YELLOW="" RED="" RESET=""
fi
step() { printf '%s==> %s%s\n' "$BOLD" "$*" "$RESET"; }
note() { printf '%s%s%s\n' "$YELLOW" "$*" "$RESET"; }
banner() { printf '%s!!! ============================================================ !!!%s\n' "$RED" "$RESET"; }

step "Checking for Docker Desktop installation..."

FOUND_DOCKER_DESKTOP=false
# Parts that still run Docker Desktop, and data that could not be removed.
BLOCKING=""
DATA_LEFT=""
# Where the question is read; chezmoi may not pass the terminal as stdin.
# ARTEFILES_TTY overrides it, as in install.sh.
TTY="${ARTEFILES_TTY:-/dev/tty}"
# Set when the user keeps the disk image of a Docker Desktop already removed.
KEEP_DISK=false

# at_terminal — whether someone can answer a question. Without a terminal
# (CI, an IDE task, ssh without -t) nobody can: the removal goes on unasked.
at_terminal() {
  [ -z "${CI:-}" ] && (: < "$TTY") 2> /dev/null
}

# ask QUESTION — prints QUESTION [y/N] and succeeds on a yes read from the terminal.
ask() {
  printf '%s%s [y/N] %s' "$BOLD" "$1" "$RESET" >&2
  answer=""
  read -r answer < "$TTY" || answer=""
  case "$answer" in
    [yY] | [yY][eE][sS]) return 0 ;;
  esac
  return 1
}

# confirm_app_removal — removing Docker Desktop deletes its containers, images
# and volumes (a volume may hold a local database). Asked once at a terminal; a
# "no" keeps everything and fails the step with the commands that save the
# data, and the next install.sh run asks again.
confirm_app_removal() {
  at_terminal || return 0
  {
    echo ""
    banner
    printf '%s!!!  Docker Desktop is forbidden and will be removed now.%s\n' "$RED" "$RESET"
    echo "!!!  This DELETES its containers, images and volumes."
    banner
  } >&2
  ask "Remove Docker Desktop and its data?" && return 0
  {
    echo ""
    banner
    echo "!!!  Docker Desktop was kept, so this step failed. To save your data first,"
    echo "!!!  with Docker Desktop running:"
    echo "!!!  1. Images:   docker save -o ~/docker-images.tar IMAGE..."
    echo "!!!  2. Volumes:  docker run --rm -v VOLUME:/data -v \"\$HOME\":/backup \\"
    echo "!!!                 alpine tar czf /backup/VOLUME.tgz -C /data ."
    echo "!!!     (list them with: docker volume ls)"
    echo "!!!  3. Run install.sh again and answer y."
    echo "!!!  After the install, Colima's docker restores them:"
    echo "!!!    docker load -i ~/docker-images.tar"
    echo "!!!    docker volume create VOLUME && docker run --rm -v VOLUME:/data \\"
    echo "!!!      -v \"\$HOME\":/backup alpine tar xzf /backup/VOLUME.tgz -C /data"
    banner
    echo ""
  } >&2
  exit 1
}

# confirm_disk_removal DIR — Docker Desktop is gone but DIR still holds its disk
# image (containers, images, volumes). Nothing can run from it, so a "no" keeps
# it and the step still succeeds: answering no must never block the install.
confirm_disk_removal() {
  at_terminal || return 0
  {
    echo ""
    note "Docker Desktop is no longer installed, but its old disk image (containers,"
    note "images and volumes) is still in $1."
  } >&2
  ask "Delete it?" && return 0
  KEEP_DISK=true
}

# [[ if eq .chezmoi.os "darwin" ]] #
DOCKER_APP="/Applications/Docker.app"
SYSTEM_LIBRARY="/Library"
LOCAL_BIN="/usr/local/bin"

# Uninstalling and the data loop below delete the disk image that holds the
# containers, images and volumes, in the app's container.
DISK="$HOME/Library/Containers/com.docker.docker"
UNINSTALL_TIMEOUT=300
if [ -d "$DOCKER_APP" ]; then
  confirm_app_removal
elif [ -d "$DISK" ]; then
  confirm_disk_removal "$DISK"
fi

if [ -d "$DOCKER_APP" ]; then
  FOUND_DOCKER_DESKTOP=true
  step "Found Docker Desktop at $DOCKER_APP: removing it"

  if pgrep -x "Docker Desktop" > /dev/null 2>&1 || pgrep -x "Docker" > /dev/null 2>&1; then
    echo "Quitting Docker Desktop..."
    osascript -e 'quit app "Docker"' > /dev/null 2>&1 || true
    sleep 2
  fi

  # Docker's own uninstaller (docs.docker.com/desktop/uninstall) stops its
  # services and removes most of its files. It leaves the app and some data,
  # which the steps below remove, and it may ask for the admin password.
  # It may also wait on a dialog nobody sees, so it gets UNINSTALL_TIMEOUT
  # seconds; whatever it leaves is removed below.
  if [ -x "$DOCKER_APP/Contents/MacOS/uninstall" ]; then
    step "Running Docker's uninstaller (it may ask for your password)..."
    "$DOCKER_APP/Contents/MacOS/uninstall" < /dev/null &
    uninstaller=$!
    (
      sleep "$UNINSTALL_TIMEOUT"
      kill "$uninstaller" 2> /dev/null
    ) > /dev/null 2>&1 &
    watchdog=$!
    if wait "$uninstaller"; then
      kill "$watchdog" 2> /dev/null || true
    else
      kill "$watchdog" 2> /dev/null || true
      note "Docker's uninstaller failed or took too long; removing the app directly instead. Nothing to do." >&2
    fi
  fi

  if [ -e "$DOCKER_APP" ]; then
    echo "Removing $DOCKER_APP (sudo required)..."
    sudo rm -rf "$DOCKER_APP" || BLOCKING="$BLOCKING
  $DOCKER_APP"
  fi
fi

# Docker Desktop's privileged helpers run as root from launchd, even after the
# app is gone (the same steps as Docker's MDM script and the Homebrew cask).
for helper in com.docker.vmnetd com.docker.socket; do
  plist="$SYSTEM_LIBRARY/LaunchDaemons/$helper.plist"
  tool="$SYSTEM_LIBRARY/PrivilegedHelperTools/$helper"
  if [ -e "$plist" ] || [ -e "$tool" ]; then
    FOUND_DOCKER_DESKTOP=true
    step "Removing Docker Desktop's $helper service (sudo required)..."
    sudo launchctl bootout system "$plist" > /dev/null 2>&1 || true
    sudo rm -f "$plist" "$tool" || BLOCKING="$BLOCKING
  the $helper service ($plist, $tool)"
  fi
done

# Docker Desktop links its CLIs into /usr/local/bin (system mode) or
# ~/.docker/bin (user mode). Only links into the app go: a docker from
# Homebrew points elsewhere and stays.
for link in "$LOCAL_BIN"/* "$HOME/.docker/bin"/*; do
  [ -L "$link" ] || continue
  case "$(readlink "$link")" in
    "$DOCKER_APP"/*)
      echo "Removing $link..."
      case "$link" in
        "$HOME"/*) rm -f "$link" || true ;;
        *) sudo rm -f "$link" || true ;;
      esac
      ;;
  esac
done

# macOS may refuse some of these ("Operation not permitted", even as the owner
# and under sudo): since macOS 15 the Group Container is protected, and the
# app's container needs Full Disk Access. They are data only.
for path in \
  "$HOME/Library/Group Containers/group.com.docker" \
  "$HOME/Library/Containers/com.docker.docker" \
  "$HOME/Library/Containers/com.docker.helper" \
  "$HOME/Library/Application Support/Docker Desktop" \
  "$HOME/Library/Preferences/com.docker.docker.plist" \
  "$HOME/Library/Preferences/com.electron.docker-frontend.plist" \
  "$HOME/Library/Saved Application State/com.electron.docker-frontend.savedState" \
  "$HOME/Library/Logs/Docker Desktop" \
  "$HOME/Library/Caches/com.docker.docker" \
  "$HOME/.docker/desktop"; do
  if [ -e "$path" ]; then
    FOUND_DOCKER_DESKTOP=true
    if [ "$KEEP_DISK" = true ] && [ "$path" = "$DISK" ]; then
      echo "Keeping $path, as asked."
      continue
    fi
    echo "Removing $path..."
    rm -rf "$path" 2> /dev/null || DATA_LEFT="$DATA_LEFT
  $path"
  fi
done
# [[ end ]] #

# [[ if eq .chezmoi.os "linux" ]] #
# Linux Docker Desktop ships as the docker-desktop package; its VM, with the
# containers, images and volumes, lives under ~/.docker/desktop.
DISK="$HOME/.docker/desktop"
if command -v docker-desktop > /dev/null 2>&1; then
  confirm_app_removal
elif [ -d "$DISK" ]; then
  confirm_disk_removal "$DISK"
fi

if command -v docker-desktop > /dev/null 2>&1; then
  FOUND_DOCKER_DESKTOP=true
  step "Found docker-desktop in PATH: removing it"
  # The VM writes to ~/.docker/desktop while it runs.
  systemctl --user stop docker-desktop > /dev/null 2>&1 || true
  # The steps of docs.docker.com/desktop/uninstall: purge also drops its
  # systemd files.
  if command -v apt-get > /dev/null 2>&1 && dpkg -s docker-desktop > /dev/null 2>&1; then
    echo "Removing docker-desktop via apt (sudo required)..."
    sudo apt-get purge -y docker-desktop || BLOCKING="$BLOCKING
  the docker-desktop package (sudo apt-get purge docker-desktop failed)"
  elif command -v dnf > /dev/null 2>&1 && rpm -q docker-desktop > /dev/null 2>&1; then
    echo "Removing docker-desktop via dnf (sudo required)..."
    sudo dnf remove -y docker-desktop || BLOCKING="$BLOCKING
  the docker-desktop package (sudo dnf remove docker-desktop failed)"
  else
    # pacman or a hand install: there is no package to remove here.
    BLOCKING="$BLOCKING
  $(command -v docker-desktop) (not installed with apt or dnf)"
  fi
  if [ -e /usr/local/bin/com.docker.cli ]; then
    sudo rm -f /usr/local/bin/com.docker.cli || true
  fi
fi

for path in \
  "$HOME/.docker/desktop" \
  "$HOME/.config/docker-desktop"; do
  if [ -e "$path" ]; then
    FOUND_DOCKER_DESKTOP=true
    if [ "$KEEP_DISK" = true ] && [ "$path" = "$DISK" ]; then
      echo "Keeping $path, as asked."
      continue
    fi
    echo "Removing $path..."
    rm -rf "$path" 2> /dev/null || DATA_LEFT="$DATA_LEFT
  $path"
  fi
done
# [[ end ]] #

if [ "$KEEP_DISK" = true ]; then
  note "Docker Desktop's old disk image was kept in $DISK."
  note "Delete it when you no longer need it:  rm -rf \"$DISK\""
fi

if [ -n "$DATA_LEFT" ]; then
  note "Some Docker Desktop data could not be removed (the system protects it)."
  note "Docker Desktop cannot run from it, so there is nothing to do:$DATA_LEFT"
fi

if [ -n "$BLOCKING" ]; then
  # stderr, so the block stays visible when chezmoi's output is piped.
  # Colours follow stdout: install.sh sends stderr through tee to the terminal.
  {
    echo ""
    banner
    printf '%s!!!  Docker Desktop is still installed, so this step failed:%s%s\n' "$RED" "$RESET" "$BLOCKING"
    # [[ if eq .chezmoi.os "darwin" ]] #
    echo "!!!  macOS (or sudo) refused to remove it. To finish:"
    echo "!!!  1. In System Settings > Privacy & Security > App Management, allow"
    echo "!!!     your terminal (${TERM_PROGRAM:-the app you run install.sh in})."
    # A CI runner has no one to click; the pane only helps at a desk.
    if [ -z "${CI:-}" ] && command -v open > /dev/null 2>&1 \
      && open "x-apple.systempreferences:com.apple.preference.security?Privacy_AppBundles"; then
      echo "!!!     System Settings is now open on that page."
    fi
    echo "!!!  2. Quit the terminal (Cmd-Q) and reopen it."
    echo "!!!  3. Then run install.sh again: it retries this step."
    echo "!!!  If you cannot change that setting (a Mac managed by IT), drag Docker"
    echo "!!!  from Applications to the Trash in Finder, then run install.sh again."
    echo "!!!  If sudo refused your password, your account may lack admin rights:"
    echo "!!!  ask your IT team to remove Docker Desktop."
    # [[ else ]] #
    echo "!!!  To finish:"
    echo "!!!  1. Check that sudo works:  sudo -v"
    echo "!!!     If it was not installed with apt or dnf, remove it the way it was"
    echo "!!!     installed (e.g. sudo pacman -R docker-desktop)."
    echo "!!!  2. Then run install.sh again: it retries this step."
    echo "!!!  Without admin rights, ask your IT team to remove Docker Desktop."
    # [[ end ]] #
    banner
    echo ""
  } >&2
  exit 1
elif [ "$FOUND_DOCKER_DESKTOP" = true ]; then
  step "Docker Desktop removal complete."
else
  echo "No Docker Desktop installation found."
fi

# Warning file documenting the policy and replacements.
mkdir -p "$HOME/.local/share" || exit 0
cat > "$HOME/.local/share/docker_desktop_warning.txt" << EOF
This environment prohibits the use of Docker Desktop as part of the dotfiles policy.
Please use one of the following alternatives:
- Colima (recommended on macOS): https://github.com/abiosoft/colima
- Native Docker Engine (Linux): https://docs.docker.com/engine/install/

The 'docker' CLI itself is fine — only Docker Desktop (the GUI/VM bundle) is forbidden.

If you have questions, please consult your team's documentation.
EOF

echo "Created warning file at $HOME/.local/share/docker_desktop_warning.txt"

# [[ end ]] #
