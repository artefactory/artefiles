#!/bin/sh
# chezmoi:template:left-delimiter="# [[" right-delimiter="]] #"
# Installs the git hook manager chosen with the pre_commit or prek module and
# generates the global git template hooks (~/.git_template/hooks) with it, so
# every `git init` and clone gets them. prek wins if both modules are selected.
# Runs last (zzzzz prefix) to ensure uv is available.
#
# Selected tool: # [[ ternary "prek" "pre-commit" (has "prek" .modules) ]] #

set -eu

TOOL=# [[ ternary "prek" "pre-commit" (has "prek" .modules) | quote ]] #
LOCAL_BIN_DIR="$HOME/.local/bin"
TEMPLATE_DIR="$HOME/.git_template"
HOOK_TYPES="commit-msg pre-commit pre-push"

command_exists() {
  command -v "$1" > /dev/null 2>&1
}

mkdir -p "$LOCAL_BIN_DIR"
PATH="$LOCAL_BIN_DIR:$PATH"
export PATH

UV_CMD="uv"
if ! command_exists uv; then
  if [ -x "$LOCAL_BIN_DIR/uv" ]; then
    UV_CMD="$LOCAL_BIN_DIR/uv"
    echo "Using uv from $LOCAL_BIN_DIR"
  else
    echo "uv is required but not installed. Install uv first."
    exit 1
  fi
fi

"$UV_CMD" tool install --upgrade "$TOOL" || echo "Error: Failed to install/upgrade $TOOL"

if ! command_exists "$TOOL"; then
  echo "$TOOL is not available; skipping git hook templates."
  exit 0
fi

# A generated shim carries its tool's marker. Another tool's shim is replaced
# so the hooks follow the selected module; a hook the user wrote is kept.
mkdir -p "$TEMPLATE_DIR/hooks"
set --
for hook in $HOOK_TYPES; do
  file="$TEMPLATE_DIR/hooks/$hook"
  if [ ! -f "$file" ]; then
    set -- "$@" -t "$hook"
  elif grep -q "File generated by $TOOL" "$file"; then
    echo "Git hook template '$hook' already generated by $TOOL, skipping"
  elif grep -qE "File generated by (pre-commit|prek)" "$file"; then
    echo "Replacing the other tool's '$hook' template"
    rm -f "$file"
    set -- "$@" -t "$hook"
  else
    echo "Warning: $file is not a generated hook; leaving it alone" >&2
  fi
done

if [ "$#" -eq 0 ]; then
  echo "All git hook templates are up to date, skipping"
  exit 0
fi

echo "Generating git hook templates with $TOOL..."
if [ "$TOOL" = "prek" ]; then
  prek util init-template-dir "$TEMPLATE_DIR" "$@"
else
  pre-commit init-templatedir "$@" "$TEMPLATE_DIR"
fi
