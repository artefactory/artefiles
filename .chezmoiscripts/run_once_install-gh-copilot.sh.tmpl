#!/bin/sh
# chezmoi:template:left-delimiter="# [[" right-delimiter="]] #"
set -eu

# Check if gh is installed
if ! command -v gh > /dev/null 2>&1; then
  echo "GitHub CLI (gh) is not installed. Please install it first."
  exit 1
fi

# Newer gh versions ship a built-in "copilot" command. If it exists, skip install.
if gh help copilot > /dev/null 2>&1; then
  echo "GitHub Copilot command already available in gh. Skipping extension install."
  exit 0
fi

# If extension already installed, skip to avoid failure.
if gh extension list | awk '{print $1}' | grep -qx "gh-copilot"; then
  echo "GitHub Copilot extension already installed. Skipping."
  exit 0
fi

echo "Installing GitHub Copilot extension for gh CLI..."
gh extension install github/gh-copilot
