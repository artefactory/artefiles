# chezmoi:template:left-delimiter="# [[" right-delimiter="]] #"
# [[ if eq .chezmoi.os "linux" ]] #
# External dependencies managed by chezmoi for Linux systems
# Reference: https://www.chezmoi.io/reference/special-files-and-directories/chezmoiexternal-format/

# [[ $rustArch := (eq .chezmoi.arch "amd64" | ternary "x86_64" "aarch64") ]] #
# [[ $fzfArch := (eq .chezmoi.arch "amd64" | ternary "amd64" "arm64") ]] #
# [[ $libc := "gnu" ]] #
# [[ if eq .chezmoi.arch "arm64" ]] #
#   [[ $libc = "musl" ]] #
# [[ end ]] #

# [[ if has "editor" .modules ]] #
# Neovim AppImage
[".local/bin/nvim"]
  type = "file"
  url = # [[ printf "https://github.com/neovim/neovim/releases/download/stable/nvim-linux-%s.appimage" (eq .chezmoi.arch "amd64" | ternary "x86_64" "arm64") | quote ]] #
  refreshPeriod = "672h"
  executable = true
# [[ end ]] #

# eza - A modern replacement for 'ls'
[".local/bin/eza"]
  type = "archive-file"
  url = # [[ gitHubLatestReleaseAssetURL "eza-community/eza" (printf "eza_%s-unknown-linux-gnu.zip" $rustArch) | quote ]] #
  executable = true
  path = "eza"

# bat - A cat clone with syntax highlighting
[".local/bin/bat"]
  type = "archive-file"
  url = # [[ gitHubLatestReleaseAssetURL "sharkdp/bat" (printf "bat-*-%s-unknown-linux-gnu.tar.gz" $rustArch) | quote ]] #
  executable = true
  stripComponents = 1
  path = "bat"

# fd - A simple, fast and user-friendly alternative to 'find'
[".local/bin/fd"]
  type = "archive-file"
  url = # [[ gitHubLatestReleaseAssetURL "sharkdp/fd" (printf "fd-*-%s-unknown-linux-gnu.tar.gz" $rustArch) | quote ]] #
  executable = true
  stripComponents = 1
  path = "fd"

# [[ if has "git_advanced" .modules ]] #
# difftastic - A structural diff tool
[".local/bin/difft"]
  type = "archive-file"
  url = # [[ gitHubLatestReleaseAssetURL "Wilfred/difftastic" (printf "difft-%s-unknown-linux-gnu.tar.gz" $rustArch) | quote ]] #
  executable = true
  path = "difft"

# mergiraf - A syntax-aware merge tool
# Codeberg has no chezmoi helper analogous to gitHubLatestReleaseAssetURL,
# so we resolve the latest tag via the Gitea API at template render time.
# Use chezmoi's built-in httpGet/fromJson rather than shelling out to
# curl+sed: same network dependency, but no external process per render
# and the JSON parse is robust against whitespace/key-order changes.
# [[ $mergirafTag := (output "curl" "-fsSL" "--max-time" "10" "https://codeberg.org/api/v1/repos/mergiraf/mergiraf/releases/latest" | fromJson).tag_name ]] #
[".local/bin/mergiraf"]
  type = "archive-file"
  url = # [[ printf "https://codeberg.org/mergiraf/mergiraf/releases/download/%s/mergiraf_%s-unknown-linux-gnu.tar.gz" $mergirafTag $rustArch | quote ]] #
  executable = true
  path = "mergiraf"

