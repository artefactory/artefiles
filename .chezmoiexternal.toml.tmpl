# chezmoi:template:left-delimiter="# [[" right-delimiter="]] #"
# [[ $modules := includeTemplate "modules" . | fromJson ]] #
# [[/* CI passes --override-data '{"ciSkipExternals":true}': --exclude=externals
#      does not stop chezmoi from downloading the archives, an empty file does. */]] #
# [[ if and (eq .chezmoi.os "linux") (not (get . "ciSkipExternals")) ]] #
# External dependencies managed by chezmoi for Linux systems
# Reference: https://www.chezmoi.io/reference/special-files-and-directories/chezmoiexternal-format/

# [[ $rustArch := (eq .chezmoi.arch "amd64" | ternary "x86_64" "aarch64") ]] #
# [[ $fzfArch := (eq .chezmoi.arch "amd64" | ternary "amd64" "arm64") ]] #

# fish - the default shell; the release's static build, so nothing is compiled.
# run_onchange_z-install-fish.sh starts it from bash and zsh.
[".local/bin/fish"]
  type = "archive-file"
  url = # [[ gitHubLatestReleaseAssetURL "fish-shell/fish-shell" (printf "fish-*-linux-%s.tar.xz" $rustArch) | quote ]] #
  executable = true
  path = "fish"

# [[ if has "editor" $modules ]] #
# Neovim AppImage
[".local/bin/nvim"]
  type = "file"
  url = # [[ printf "https://github.com/neovim/neovim/releases/download/stable/nvim-linux-%s.appimage" (eq .chezmoi.arch "amd64" | ternary "x86_64" "arm64") | quote ]] #
  refreshPeriod = "672h"
  executable = true
# [[ end ]] #

# [[ if has "shell_tools" $modules ]] #
# eza - A modern replacement for 'ls'
[".local/bin/eza"]
  type = "archive-file"
  url = # [[ gitHubLatestReleaseAssetURL "eza-community/eza" (printf "eza_%s-unknown-linux-gnu.zip" $rustArch) | quote ]] #
  executable = true
  path = "eza"
# [[ end ]] #

# [[ if has "shell_tools" $modules ]] #
# bat - A cat clone with syntax highlighting
[".local/bin/bat"]
  type = "archive-file"
  url = # [[ gitHubLatestReleaseAssetURL "sharkdp/bat" (printf "bat-*-%s-unknown-linux-gnu.tar.gz" $rustArch) | quote ]] #
  executable = true
  stripComponents = 1
  path = "bat"
# [[ end ]] #

# [[ if has "shell_tools" $modules ]] #
# fd - A simple, fast and user-friendly alternative to 'find'
[".local/bin/fd"]
  type = "archive-file"
  url = # [[ gitHubLatestReleaseAssetURL "sharkdp/fd" (printf "fd-*-%s-unknown-linux-gnu.tar.gz" $rustArch) | quote ]] #
  executable = true
  stripComponents = 1
  path = "fd"
# [[ end ]] #

# mergiraf - A syntax-aware merge tool
# Hosted on Codeberg, which has no chezmoi helper analogous to
# gitHubLatestReleaseAssetURL; the tag is pinned in .chezmoidata/versions.yaml
# instead of being looked up at render time.
[".local/bin/mergiraf"]
  type = "archive-file"
  url = # [[ printf "https://codeberg.org/mergiraf/mergiraf/releases/download/%s/mergiraf_%s-unknown-linux-gnu.tar.gz" .versions.mergiraf $rustArch | quote ]] #
  executable = true
  path = "mergiraf"

